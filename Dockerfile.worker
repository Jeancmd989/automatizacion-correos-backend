# ─────────────────────────────────────────────────────────────────────
# Imagen de los workers.
#
# Este es el contenedor que abre ficheros de terceros, asi que concentra
# los controles de aislamiento. Las bibliotecas nativas de parseo
# (Tesseract, poppler, OpenCV) se instalan aqui y en ningun otro sitio.
#
# El endurecimiento en tiempo de ejecucion (rootfs de solo lectura,
# cap_drop, seccomp, limites de CPU y memoria, egress restringido) se
# declara en docker-compose.yml y en el manifiesto de despliegue: son
# propiedades del runtime, no de la imagen.
# ─────────────────────────────────────────────────────────────────────

FROM python:3.12-slim-bookworm AS constructor

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src/ ./src/

RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
 && /opt/venv/bin/pip install .


# ─────────────────────────────────────────────────────────────────────
FROM python:3.12-slim-bookworm AS final

# OMP_NUM_THREADS / OPENBLAS_NUM_THREADS a 1: sin esto, OpenCV y numpy
# lanzan un hilo por nucleo cada uno y compiten entre si; con varios jobs
# concurrentes el worker pasa mas tiempo en cambios de contexto que
# trabajando. El paralelismo lo da ARQ, no las bibliotecas.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

RUN groupadd --gid 10001 mailauto \
 && useradd --uid 10001 --gid mailauto --no-create-home --shell /usr/sbin/nologin mailauto \
 && apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends \
      libpq5 \
      tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
      poppler-utils \
      libgl1 libglib2.0-0 \
 && /usr/local/bin/python -m pip install --no-cache-dir --upgrade 'setuptools>=84.0.0' \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=constructor /opt/venv /opt/venv
COPY --chown=mailauto:mailauto src/ ./src/

# Directorio de trabajo efimero. En ejecucion se monta como tmpfs, de
# modo que nada de lo que el worker escriba persista entre jobs.
RUN mkdir -p /tmp/mailauto && chown mailauto:mailauto /tmp/mailauto
ENV TMPDIR=/tmp/mailauto

USER mailauto

CMD ["arq", "mailauto.workers.settings.WorkerDeIngesta"]
